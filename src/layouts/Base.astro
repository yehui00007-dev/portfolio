---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site.config';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name}, ${site.role}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script is:inline>
      // Lock the page before paint unless this session already entered the password.
      try {
        if (sessionStorage.getItem('site-unlocked') !== '1') {
          document.documentElement.classList.add('locked');
        }
      } catch (e) {
        document.documentElement.classList.add('locked');
      }
    </script>
    <ClientRouter />
  </head>
  <body>
    <div class="gate" id="gate">
      <form class="gate__form" id="gate-form">
        <p class="gate__title">This site is private.</p>
        <div class="gate__field">
          <input
            class="gate__input"
            id="gate-input"
            type="password"
            placeholder="Password"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            aria-label="Password"
          />
          <button
            type="button"
            class="gate__toggle"
            id="gate-toggle"
            aria-label="Show password"
            aria-pressed="false"
          >
            <svg class="gate__eye" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
              <circle cx="12" cy="12" r="3" />
            </svg>
            <svg class="gate__eye-off" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden>
              <path d="M3 3l18 18" />
              <path d="M10.6 5.1A10.8 10.8 0 0 1 12 5c6.5 0 10 7 10 7a18.4 18.4 0 0 1-3 3.9M6.6 6.6A18.4 18.4 0 0 0 2 12s3.5 7 10 7a10.6 10.6 0 0 0 4.9-1.1" />
              <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" />
            </svg>
          </button>
        </div>
        <button class="gate__btn" type="submit">Enter</button>
        <p class="gate__error" id="gate-error" hidden>Incorrect password.</p>
      </form>
    </div>
    <style is:global>
      html.locked {
        overflow: hidden;
      }
      .gate {
        position: fixed;
        inset: 0;
        z-index: 1000;
        display: none;
        place-items: center;
        padding: 24px;
        background: #fff;
      }
      html.locked .gate {
        display: grid;
      }
      .gate__form {
        display: flex;
        flex-direction: column;
        gap: 16px;
        width: 100%;
        max-width: 280px;
        text-align: center;
      }
      .gate__title {
        margin: 0;
        font-size: var(--fs-body);
        color: var(--ink);
      }
      .gate__field {
        position: relative;
        width: 100%;
      }
      .gate__input,
      .gate__btn {
        font: inherit;
        font-size: var(--fs-body);
        padding: 12px 14px;
        border-radius: 8px;
        width: 100%;
      }
      .gate__input {
        border: 1px solid var(--ink);
        background: #fff;
        color: var(--ink);
        padding-right: 46px;
      }
      .gate__input::placeholder {
        color: var(--muted);
      }
      .gate__toggle {
        position: absolute;
        top: 50%;
        right: 6px;
        transform: translateY(-50%);
        display: grid;
        place-items: center;
        width: 34px;
        height: 34px;
        padding: 0;
        border: none;
        background: none;
        color: var(--muted);
        cursor: pointer;
      }
      .gate__toggle:hover {
        color: var(--ink);
      }
      .gate__toggle svg {
        display: block;
      }
      .gate__toggle svg[hidden] {
        display: none;
      }
      .gate__btn {
        border: none;
        background: var(--ink);
        color: #fff;
        cursor: pointer;
      }
      .gate__error {
        margin: 0;
        font-size: var(--fs-label);
        color: var(--ink);
      }
    </style>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Runs on first load and after every client-side navigation.
      function init() {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Media settles in as it enters the viewport (once).
        const revealEls = document.querySelectorAll<HTMLElement>('.reveal:not(.is-in)');
        if (reduce || !('IntersectionObserver' in window)) {
          revealEls.forEach((el) => el.classList.add('is-in'));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((e) => {
                if (e.isIntersecting) {
                  e.target.classList.add('is-in');
                  io.unobserve(e.target);
                }
              });
            },
            { rootMargin: '0px 0px -10% 0px', threshold: 0.08 },
          );
          revealEls.forEach((el) => io.observe(el));
        }

        // Looping videos only play while on screen (saves battery + bandwidth).
        const vids = document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]');
        if (reduce) {
          vids.forEach((v) => v.setAttribute('controls', ''));
        } else if ('IntersectionObserver' in window) {
          const vio = new IntersectionObserver(
            (entries) => {
              entries.forEach((e) => {
                const v = e.target as HTMLVideoElement;
                if (e.isIntersecting) v.play().catch(() => {});
                else v.pause();
              });
            },
            { threshold: 0.25 },
          );
          vids.forEach((v) => vio.observe(v));
        }

        // Before/after sliders.
        document.querySelectorAll<HTMLElement>('[data-compare]').forEach((el) => {
          const input = el.querySelector<HTMLInputElement>('input[type="range"]');
          if (!input || input.dataset.bound) return;
          input.dataset.bound = '1';
          const set = () => el.style.setProperty('--pos', `${input.value}%`);
          input.addEventListener('input', set);
          set();
        });
      }

      // Nav tucks away while scrolling down, returns on scroll up.
      let lastY = 0;
      function onScroll() {
        const nav = document.querySelector<HTMLElement>('.nav');
        if (!nav) return;
        const y = window.scrollY;
        nav.classList.toggle('nav--scrolled', y > 8);
        nav.classList.toggle('nav--hidden', y > 240 && y > lastY);
        lastY = y;
      }
      window.addEventListener('scroll', onScroll, { passive: true });

      // Client-side password gate. Note: this only hides the page in the
      // browser; it is not real security. The password is stored as a SHA-256
      // hash so it is not readable in the source.
      const GATE_HASH =
        '756ee15750a09afe9c2cebd49a2d0eabd2d916ff88932aef8a37095d6aa792cf';
      function initGate() {
        const form = document.getElementById('gate-form') as HTMLFormElement | null;
        const input = document.getElementById('gate-input') as HTMLInputElement | null;
        const error = document.getElementById('gate-error');
        if (!form || !input) return;
        if (document.documentElement.classList.contains('locked')) input.focus();
        if (form.dataset.bound) return;
        form.dataset.bound = '1';

        const toggle = document.getElementById('gate-toggle');
        const eye = document.querySelector<SVGElement>('.gate__eye');
        const eyeOff = document.querySelector<SVGElement>('.gate__eye-off');
        toggle?.addEventListener('click', () => {
          const show = input.type === 'password';
          input.type = show ? 'text' : 'password';
          toggle.setAttribute('aria-pressed', String(show));
          toggle.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
          if (eye) eye.toggleAttribute('hidden', show);
          if (eyeOff) eyeOff.toggleAttribute('hidden', !show);
          input.focus();
        });
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const buf = await crypto.subtle.digest(
            'SHA-256',
            new TextEncoder().encode(input.value),
          );
          const hex = Array.from(new Uint8Array(buf))
            .map((b) => b.toString(16).padStart(2, '0'))
            .join('');
          if (hex === GATE_HASH) {
            try {
              sessionStorage.setItem('site-unlocked', '1');
            } catch (err) {}
            document.documentElement.classList.remove('locked');
          } else if (error) {
            error.hidden = false;
            input.value = '';
            input.focus();
          }
        });
      }

      document.addEventListener('astro:page-load', () => {
        lastY = 0;
        onScroll();
        init();
        initGate();
      });
    </script>
  </body>
</html>
