---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getWork } from '../lib/work';
import { site } from '../site.config';

const work = await getWork();
---

<Base>
  <div class="container page">
    <h1 class="intro display rise">{site.intro}</h1>
    <ul class="projects">
      {
        work.map((entry, i) => (
          <li class="rise" style={i === 0 ? '--delay: 240ms' : undefined}>
            <ProjectCard entry={entry} eager={i === 0} />
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .intro {
    max-width: 18.5em;
  }
  .projects {
    list-style: none;
    margin: var(--space-hero) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-cards);
  }
  /* Only the first card joins the load sequence; the rest are already in place. */
  .projects li:not(:first-child) { animation: none; }
</style>
