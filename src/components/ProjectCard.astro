---
import type { CollectionEntry } from 'astro:content';
import { hasFile } from '../lib/media';

interface Props {
  entry: CollectionEntry<'work'>;
  eager?: boolean;
}

const { entry, eager = false } = Astro.props;
const { cardTitle, meta, cover, coverLabel, draft } = entry.data;
const showCover = hasFile(cover);
---

<a class="card" href={`/work/${entry.id}/`}>
  <div class="card__media frame" transition:name={`cover-${entry.id}`}>
    {
      showCover ? (
        <img
          src={cover}
          alt=""
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : 'auto'}
          decoding="async"
        />
      ) : (
        <div class="ph">
          <span class="ph__label">{coverLabel}</span>
          <span class="ph__meta">Cover placeholder</span>
        </div>
      )
    }
    <span class="card__arrow" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path d="M4.5 11.5l7-7M5.5 4.5h6v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
    {draft && <span class="card__draft">Draft, hidden on live site</span>}
  </div>
  <p class="card__meta label">{meta}</p>
  <h2 class="card__title">{cardTitle}</h2>
</a>

<style>
  .card {
    display: block;
  }
  .card__media {
    aspect-ratio: 358 / 214;
  }
  @media (min-width: 640px) {
    .card__media { aspect-ratio: 640 / 368; }
  }
  @media (min-width: 1200px) {
    .card__media { aspect-ratio: 1760 / 712; }
  }
  .card__media > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease);
  }
  .card:hover .card__media > img,
  .card:hover .card__media > .ph { transform: scale(1.03); }
  .card__media > .ph { transition: transform 1.2s var(--ease); }

  .card__arrow {
    position: absolute;
    left: 24px;
    bottom: 24px;
    display: none;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    color: #fff;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: background 400ms var(--ease), color 400ms var(--ease), transform 600ms var(--ease);
  }
  @media (min-width: 640px) {
    .card__arrow { display: grid; }
  }
  /* On a gray placeholder, a white arrow would vanish. */
  .card__media:has(.ph) .card__arrow {
    background: rgba(0, 0, 0, 0.06);
    color: var(--ink);
  }
  .card:hover .card__arrow {
    background: #fff;
    color: #000;
    transform: rotate(45deg);
  }

  .card__draft {
    position: absolute;
    top: 16px;
    left: 16px;
    padding: 6px 10px;
    border-radius: 999px;
    background: #fff;
    font-size: 12px;
    line-height: 1.2;
  }

  .card__meta {
    margin-top: 16px;
  }
  @media (min-width: 640px) {
    .card__meta { margin-top: 24px; }
  }
  .card__title {
    margin-top: 8px;
    font-size: var(--fs-card);
    line-height: 1.4;
  }
</style>
