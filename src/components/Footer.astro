---
import { site } from '../site.config';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <p class="footer__label">Contact</p>
    <a class="footer__email" href={`mailto:${site.email}`}>{site.email}</a>
    <div class="footer__bottom">
      <ul>
        <li><a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a href={site.resume} target="_blank" rel="noopener">Resume</a></li>
      </ul>
      <p>© {year} {site.name}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #000;
    color: #fff;
    padding-block: 48px;
  }
  @media (min-width: 640px) {
    .footer { padding-block: 64px; }
  }
  @media (min-width: 1200px) {
    .footer { padding-block: 80px; }
  }
  .footer__label {
    font-size: 16px;
    line-height: 1.4;
  }
  .footer__email {
    display: inline-block;
    margin-top: 12px;
    font-size: var(--fs-footer);
    line-height: 1.2;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 600ms var(--ease);
  }
  .footer__email:hover { background-size: 100% 1px; }
  @media (min-width: 640px) {
    .footer__email { margin-top: 24px; }
  }
  .footer__bottom {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px 32px;
    font-size: 16px;
    color: rgba(255, 255, 255, 0.6);
  }
  .footer__bottom ul {
    display: flex;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer__bottom a { transition: color 200ms ease; }
  .footer__bottom a:hover { color: #fff; }
  :global(.footer :focus-visible) { outline-color: #fff; }
</style>
