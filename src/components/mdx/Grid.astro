---
/**
 * Side-by-side media. Stacks to one column on phones.
 * <Grid cols={2}>
 *   <Media label="Before" ratio="4:3" />
 *   <Media label="After" ratio="4:3" />
 * </Grid>
 */
interface Props {
  cols?: 2 | 3 | 4;
  size?: 'text' | 'wide' | 'full';
  caption?: string;
}
const { cols = 2, size = 'wide', caption } = Astro.props;
---

<div class:list={['block', `w-${size}`]}>
  <div class="grid" style={`--cols: ${cols}`}>
    <slot />
  </div>
  {caption && <p class="caption">{caption}</p>}
</div>

<style>
  .grid {
    display: grid;
    gap: 16px;
    grid-template-columns: 1fr;
    align-items: start;
  }
  @media (min-width: 640px) {
    .grid {
      gap: 24px;
      grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    }
  }
</style>
